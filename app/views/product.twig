{# ProducController supplies product details; main.js previews option prices and sends the chosen IDs as JSON. #}<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <title>Zen-Zen Snack Haus</title>
    <link href="{{ base_url }}public/style/style.css" rel="stylesheet"/>
  </head>
  <body data-page="product">
    {% include '/components/header.twig' %}
    {# Details stay keyed by product ID in PHP; iterate over the supplied product records for rendering. #}{% for prod in products %}
      {# Use the stored availability to control the badge and cart submission controls. #}{% set productUnavailable = prod.availability != 'Available' %}
      <section class="page-shell" id="product" data-id="{{prod.id}}">
        <a class="back-link" href="/products"> ← Back to menu </a>

        <div class="detail-layout" style="margin-top: 25px">
          <div class="gallery">

            {# Product thumbnails #}
            <div class="thumbs">
              {# Show each saved image as a thumbnail; JavaScript changes the main photo on click. #}{% for image in prod.images %}
                <button
                  class="{{ loop.first ? 'selected' : '' }}"
                  aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                  type="button"
                >
                  <img
                    src="/{{ image.image_path }}"
                    alt="{{ prod.product_name }}"
                  />
                </button>

              {% endfor %}
            </div>

            {# Main product image #}
            <div class="main-photo">
              <img
                src="/{{ prod.images[0].image_path }}"
                alt="{{ prod.product_name }}"
              />
            </div>

          </div>
        </div>

        <div class="detail-copy">
          <span class="kicker"> {{ prod.category }} </span>
          <h1>{{ prod.product_name }}</h1>
          <p>
            {{ prod.description }}
          </p>
          <strong class="detail-price"> ₱{{ prod.base_price }} </strong>
          {# Keep the unavailable state visible and prevent a normal add-to-cart action. #}{% if productUnavailable %}
            <span class="stock product-unavailable-note">Unavailable</span>
          {% else %}
            <span class="stock"> ● In stock · Ready in 10~15 min </span>
          {% endif %}
          <div class="option-block">

            {# Step: Collect product options; JavaScript sends JSON and the server checks them again. #}
            {# Data attributes provide preview prices and sign-in state; server validation remains authoritative. #}<form
              action="/addToCart/{{prod.id}}"
              method="POST"
              data-cart-form
              data-base-price="{{ prod.base_price }}"
              data-product-unavailable="{{ productUnavailable ? 'true' : 'false' }}"
              data-login-required="{{ is_logged_in ? 'false' : 'true' }}"
              {% if not is_logged_in %}novalidate{% endif %}
            >
              {# Size chooser #}
              <h4>
                Choose a variants
                <small>Required</small>
              </h4>

              <div class="option-block">
                <h4>Variants</h4>

                <div class="option-grid" id="productRadioVariant">
                  {# Track whether an in-stock variant has been chosen so the first available one becomes the default. #}{% set variantSelected = false %}
                  {# Use variant IDs as submitted values and disable sold-out choices; the server rechecks stock. #}{% for variant in prod.variants %}
                    <label class="option">

                      <input
                        type="radio"
                        name="variant_id"
                        value="{{ variant.id }}"
                        {# Select the first in-stock option only, skipping variants with no remaining units. #}{% if not variantSelected and variant.stock_quantity > 0 %}
                          checked
                          {# Track whether an in-stock variant has been chosen so the first available one becomes the default. #}{% set variantSelected = true %}
                        {% endif %}
                        {% if variant.stock_quantity <= 0 %}disabled{% endif %}
                        required
                        data-price="{{variant.price}}"
                      />

                      <b>{{ variant.size_oz }}</b>

                      <small>
                        ₱{{ variant.price|number_format(2) }}

                        {% if variant.stock_quantity <= 0 %}
                          - Out of stock
                        {% endif %}
                      </small>

                    </label>
                  {% else %}
                    <p>No sizes available for this product.</p>
                  {% endfor %}
                </div>
              </div>
              {# end size chooser #}
              {# Only products with supported flavour options display this required chooser. #}{% if prod.flavours is not empty %}
                <fieldset class="option-block flavour-choice">
                  <legend>Choose a flavour <small>Required</small></legend>
                  <div class="option-grid">
                    {% set flavourSelected = false %}
                    {# Show current availability, disabling blocked flavours and selecting the first available choice. #}{% for flavour in prod.flavours %}
                      <label class="option{% if not flavour.available %} option-unavailable{% endif %}">
                        <input
                          type="radio"
                          name="flavour"
                          value="{{ flavour.name }}"
                          required
                          {% if not flavour.available %}disabled{% elseif not flavourSelected %}checked{% set flavourSelected = true %}{% endif %}
                        />
                        <b>{{ flavour.name }}</b>
                        <small>{{ flavour.available ? 'Available' : 'Unavailable' }}</small>
                      </label>
                    {% endfor %}
                  </div>
                  {# Explain when every flavour is blocked instead of allowing an unavailable default. #}{% if not flavourSelected %}
                    <p role="status">All flavours are currently unavailable.</p>
                  {% endif %}
                </fieldset>
              {% endif %}
              {# Mix-n-Match also requires an available side snack. #}{% if prod.category == 'Mix-n-Match' %}
                <fieldset class="option-block">
                  <legend>Side Snacks <small>Required</small></legend>
                  <div class="option-grid">
                    {% set sideSnackSelected = false %}
                    {# Display the model-provided snack list and choose the first available snack. #}{% for snack in prod.side_snacks %}
                      <label class="option{% if not snack.available %} option-unavailable{% endif %}">
                        <input
                          type="radio"
                          name="side_snack"
                          value="{{ snack.name }}"
                          required
                          {% if not snack.available %}disabled{% elseif not sideSnackSelected %}checked{% set sideSnackSelected = true %}{% endif %}
                        />
                        <b>{{ snack.name }}</b>
                        <small>{{ snack.available ? 'Included' : 'Unavailable' }}</small>
                      </label>
                    {% endfor %}
                  </div>
                  {# Show why the form cannot choose a snack when all options are unavailable. #}{% if not sideSnackSelected %}
                    <p role="status">All side snacks are currently unavailable.</p>
                  {% endif %}
                </fieldset>
              {% endif %}
              {# Keep sugar controls for current Coffee Series and historical coffee categories. #}{% if prod.category in ['Coffee Series', 'Coffee', 'Iced-Coffee'] %}
                <div class="custom-row">
                  <label>
                    Sugar level
                    <select id="sugarLevel" name="sugar_level">
                      <option value ="100">100% - Regular</option>
                      <option value ="75">75% - Less sweet</option>
                      <option value ="50">50% - Half sweet</option>
                      <option value ="0">0% - No sugar</option>
                    </select>
                  </label>
                  {# Only the current Coffee Series exposes ice-level choices. #}{% if prod.category == 'Coffee Series' %}
                    <label>
                      Ice level
                      <select name="ice_level" required>
                        {# Use the PHP option codes for submission and the corresponding readable labels for display. #}{% for value, label in constant('App\\Models\\Product::ICE_LEVELS') %}
                          <option value="{{ value }}">{{ label }}</option>
                        {% endfor %}
                      </select>
                    </label>
                  {% endif %}

                </div>

              {% endif %}
              {# end overlooked #}

              {# Custom add-ons #}
              <div class="addons">
                <h4>Add-ons</h4>

                {# Submit checked add-on IDs; their data-price values are used only for the browser preview. #}{% for addon in prod.addons %}
                  <label class="addon">

                    <input
                      type="checkbox"
                      name="addon_ids[]"
                      value="{{ addon.id }}"
                      data-price="{{ addon.addon_price }}"
                    />

                    <span>
                      <b>{{ addon.addon_name }}</b>
                    </span>

                    <strong>
                      + ₱{{ addon.addon_price|number_format(2) }}
                    </strong>

                  </label>
                {% else %}
                  <p>No add-ons available for this product.</p>
                {% endfor %}
              </div>

              <div class="add-row">
                <div class="quantity">
                  <button type = "button" id="minusButton">−</button>
                  <b data-quantity aria-live="polite">1</b>
                  <button type = "button" id="addButton">+</button>
                </div>

                {# JavaScript updates the quantity; totalPrice is a preview field and is not trusted for cart pricing. #}<input type="hidden" name="quantity" value="1">
                <input type="hidden" name="totalPrice" value="{{prod.base_price}}" id="inputTotalPrice">
                {# Keep the unavailable state visible and prevent a normal add-to-cart action. #}{% if productUnavailable %}
                  <input type="submit" value="this product is currently unavailable" class="primary grow" disabled />
                {# Signed-in customers can submit; guests receive the sign-in link below. #}{% elseif is_logged_in %}
                  <input
                    type="submit"
                    value="Add to Cart &#8369;{{prod.base_price}}"
                    class
                    =
                    "primary grow"
                    data-totalprice="{{prod.base_price}}"
                    id="totalPriceHandler"
                    {% if (prod.flavours is not empty and not flavourSelected) or (prod.category == 'Mix-n-Match' and not sideSnackSelected) %}disabled{% endif %}
                  >
                {% else %}
                  <a href="/login" class="primary grow" style="text-align: center">Sign in to add to cart</a>
                {% endif %}
              </div>
              <p data-cart-status role="status" aria-live="polite">
              </p>
            </form>
          </div>
        </div>
      </section>
    {% endfor %}
    {% include '/components/footer.twig' %}
    {# Load shared page interactions; each initializer checks that its own page controls exist. #}<script type="module" src="{{base_url}}public/js/main.js"></script>
  </body>
</html>
