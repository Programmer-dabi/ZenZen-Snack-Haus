<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Zen-Zen Snack Haus</title>
    <link href="{{base_url}}public/style/style.css" rel="stylesheet"/>
  </head>
  <body>
    {% include 'components/header.twig' %}

    <section class="login-page" id="register">

      <div class="login-image login-image-photo">
        <a class="logo logo-light" href="/">
          <span class="logo-mark"> ZZ</span>
          <span>
            Zen-Zen Snack Haus
            <small> SNACKS &amp; REFRESHMENTS </small>
          </span>
        </a>
        <div>
          <span class="kicker"> WELCOME BACK </span>
          <h1>
            Your next great cup
            <br />
            is just a few clicks away.
          </h1>
          <p>
            Order ahead, skip the wait, and make more time for the moments that
            matter.
          </p>
        </div>
        <small> © 2026 Zen-Zen Snack Haus </small>
      </div>
      {# Step: Submit customer details; the User model hashes the password before storage. #}
      <form method='POST' action = '/addUser' class="login-card">
        <a class="back-link" href="/"> ← Back to shop </a>
        <div>
          <span class="kicker"> CUSTOMER REGISTRATION </span>
          <h1>Sign up</h1>
          <p>
            Already have an Account?
            <a href='/login'> Login here </a>
          </p>
        </div>
        <label>
          Email address
          <input placeholder="you@email.com" required="" type="email"  name = "email">
        </label>
        <label>
          Name
          <input placeholder="Enter your name" required="" type="text" name = "name">
        </label>
        <label>
          Enter your phone number
          <input placeholder="Phone Number" required="" type="number" name="phonenum">
        </label>
        <label>
          Password
          <input
            placeholder="Enter your password"
            required=""
            type="password"
            autocomplete="new-password"
            name="password"
            id="password"
          />
        </label>
        <label class="auth-checkbox">
          <input type="checkbox" data-password-toggle="password" aria-controls="password" />
          Show password
        </label>
        <label>
          Confirm Password
          <input
            placeholder="Confirm your password"
            required=""
            type="password"
            autocomplete="new-password"
            name="confpassword"
            id="confirm-password"
          />

        </label>
        <label class="auth-checkbox">
          <input type="checkbox" data-password-toggle="confirm-password" aria-controls="confirm-password" />
          Show confirmation password
        </label>
        <input type="submit" value="Sign up →" class="primary" style="text-align: center">
      </form>
    </section>

    {% include 'components/footer.twig' %}

    <script defer src="{{base_url}}public/js/auth.js"></script>
    <script type="module" src="{{base_url}}public/js/main.js"></script>
  </body>
</html>
