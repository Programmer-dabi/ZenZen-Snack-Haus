{# CartController supplies saved lines and totals; main.js enhances quantity forms with JSON updates. #}<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Zen-Zen Snack Haus</title>
    <link href="{{ base_url }}public/style/style.css" rel="stylesheet" />
  </head>
  <body>
    {# Reuse the shop header; the controller-provided cart count populates its badges. #}{% include 'components/header.twig' %}
    <section class="page-shell" id="cart">
      <div class="page-title compact">
        <span class="kicker"> YOUR ORDER </span>
        <h1>Shopping cart</h1>
        <p data-cart-summary-count>{{ cart_count }} {{ cart_count == 1 ? 'item' : 'items' }} waiting for you</p>
        <p data-cart-update-status role="status" aria-live="polite">
        </p>
        {# Display a one-time server validation message after a normal form submission. #}{% if cart_error %}
          <p role="alert">{{ cart_error }}</p>
        {% endif %}
      </div>
      <div class="cart-layout">
        <div class="cart-list">
          {# Use saved line IDs for form actions and DOM hooks so returned JSON updates the correct row. #}{% for id, item in items %}
            <article class="cart-item" data-cart-item="{{ id }}">
              {# Show the first saved product image when present; otherwise keep the layout placeholder. #}{% if item.image_path %}
                <img
                  alt="{{ item.product_name }}"
                  src="{{ base_url }}{{ item.image_path }}"
                />
              {% else %}
                <span aria-hidden="true"></span>
              {% endif %}
              <div class="cart-item-info">
                <span>{{ item.category }}</span>
                <h3>
                  <a href="/product/{{ item.product_id }}">{{ item.product_name }}</a>
                </h3>
                <p>
                  {{ item.variant_label ?: 'Standard' }}
                  {# Display only options present on this saved selection, including fields retained for older records. #}{% if item.flavour|default(null) is not null %} · Flavour: {{ item.flavour }}{% endif %}
                  {% if item.side_snack|default(null) is not null %} · Side snack: {{ item.side_snack }}{% endif %}
                  {% if item.ice_level|default(null) is not null %} · {{ constant('App\\Models\\Product::ICE_LEVELS')[item.ice_level] }}{% endif %}
                  {% if item.milk_preference is not null %} · {{ item.milk_preference|capitalize }} milk{% endif %}
                  {% if item.sugar_level is not null %} · {{ item.sugar_level }}% sugar{% endif %}
                  {% for addon in item.addons %} · {{ addon.name }}{% endfor %}
                </p>
                {# Send the saved line ID and session CSRF token to the owner-checked removal endpoint. #}<form action="/cart/{{ id }}/remove" method="POST">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                  <button type="submit">Remove</button>
                </form>
              </div>
              <div class="cart-item-end">
                <strong data-cart-line-total>₱{{ item.line_total|number_format(2) }}</strong>
                {# Buttons submit the requested next quantity; JavaScript can use the same action for live updates. #}<form class="quantity" action="/cart/{{ id }}/quantity" method="POST" data-cart-quantity-form>
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                  <button
                    type="submit"
                    name="quantity"
                    value="{{ item.quantity - 1 }}"
                    data-quantity-step="-1"
                    aria-label="Decrease quantity of {{ item.product_name }}"
                    {# Prevent a decrease below one; removal uses its own form. #}{% if item.quantity <= 1 %}disabled{% endif %}
                  >−</button>
                  <b data-cart-quantity>{{ item.quantity }}</b>
                  <button
                    type="submit"
                    name="quantity"
                    value="{{ item.quantity + 1 }}"
                    data-quantity-step="1"
                    aria-label="Increase quantity of {{ item.product_name }}"
                    {# Disable increases at the same upper limit enforced on the server. #}{% if item.quantity >= 99 %}disabled{% endif %}
                  >+</button>
                </form>
              </div>
            </article>
          {% else %}
            <p>Your cart is empty.</p>
          {% endfor %}
          <a class="back-link" href="/products"> ← Continue shopping </a>
        </div>
        {# Display totals calculated by the controller from saved unit prices, not browser-submitted amounts. #}<aside class="summary-card">
          <h2>Order summary</h2>
          <div>
            <span> Subtotal </span>
            <b data-cart-subtotal> ₱{{ subtotal|number_format(2) }} </b>
          </div>
          <div>
            <span> Pickup fee </span>
            <b class="green"> Free </b>
          </div>
          <hr />
          <div class="total">
            <span> Total </span>
            <b data-cart-total> ₱{{ total|number_format(2) }} </b>
          </div>
          <small> Taxes are included in listed prices. </small>
          <a
            class="primary"
            href="/checkout"
            style="display: block; text-align: center; margin-top: 15px"
          >
            Proceed to checkout →
          </a>
          <p class="safe-note">✓ Pay with cash at the counter</p>
        </aside>
      </div>
    </section>
    {# Reuse the common footer after this page's content. #}{% include 'components/footer.twig' %}
    {# Load shared page interactions; each initializer checks that its own page controls exist. #}<script type="module" src="{{ base_url }}public/js/main.js"></script>
  </body>
</html>
