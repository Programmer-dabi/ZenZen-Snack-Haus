{# The selected product was looked up by the authorized controller before this confirmation is rendered. #}<section id="delete-modal">
  <h2 id="admin-modal-title">Delete product?</h2>
  <p>Delete <b>{{ selected_product.product_name }}</b> and its variants and add-ons? This action cannot be undone.</p>
  {# Delete through POST with the product ID and administrator CSRF token, rather than deleting from a link. #}<form action="/admin/products/{{ selected_product.id }}/delete" method="POST">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
    <div class="admin-modal-actions">
      <a class="outline" href="/admin#admin-products">Cancel</a><button class="primary" type="submit">Delete product</button>
    </div>
  </form>
</section>
