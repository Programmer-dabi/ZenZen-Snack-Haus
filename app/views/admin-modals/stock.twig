{# This form updates one selected variant, with expected_stock guarding against stale inventory forms. #}<section id="stock-modal">
  <h2 id="admin-modal-title">Update variant stock</h2>
  <h3>{{ selected_product.product_name }}</h3>
  {# POST the product ID, variant ID, form token, requested quantity, and expected current stock. #}<form action="/admin/products/{{ selected_product.id }}/stock" method="POST" data-admin-stock-form>
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
    {# Keep the expected stock hidden for the model's locked comparison; admin.js updates it on variant changes. #}<input
      type="hidden"
      name="expected_stock"
      value="{{ selected_variant.stock_quantity }}"
      data-expected-stock
    />
    <div class="field-grid">
      <label>Variant<select name="variant_id" data-stock-variant required>
          {# Only list variants belonging to this product; data-stock supplies the matching preview and expected value. #}{% for variant in selected_product.variants %}
            <option
              value="{{ variant.id }}"
              data-stock="{{ variant.stock_quantity }}"
              {% if variant.id == selected_variant.id %}selected{% endif %}
            >{{ variant.size_oz }} · {{ variant.stock_quantity }} in stock</option>
          {% endfor %}
        </select></label>
      {# Enter an absolute stock count rather than an amount to add or subtract. #}<label>New stock quantity<input
          type="number"
          name="quantity"
          min="0"
          max="4294967295"
          step="1"
          value="{{ selected_variant.stock_quantity }}"
          required
          data-new-stock
        /></label>
    </div>
    <p>Current stock: <b data-current-stock>{{ selected_variant.stock_quantity }}</b>. This saves only the selected variant.</p>
    <div class="admin-modal-actions">
      <a class="outline" href="/admin#admin-inventory">Cancel</a><button class="primary" type="submit">Update stock</button>
    </div>
  </form>
</section>
