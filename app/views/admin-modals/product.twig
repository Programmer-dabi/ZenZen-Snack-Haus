{# The same form handles product creation and editing using controller-normalized product_form values. #}<section id="product-modal">
  <h2 id="admin-modal-title">{{ modal == 'edit-product' ? 'Edit product' : 'Add new product' }}</h2>
  <p>Set the base price and each variant’s additional price. Existing variant stock is managed in Update stock.</p>
  {# Step: Post the product fields and CSRF token to the administrator save action. #}
  {# The action uses the selected product ID only for editing; multipart encoding carries image uploads. #}<form
    action="{{ modal == 'edit-product' ? '/admin/products/' ~ selected_product.id ~ '/edit' : '/admin/products' }}"
    method="POST"
    enctype="multipart/form-data"
  >
    {# Send the administrator session token before the controller processes product changes. #}<input type="hidden" name="csrf_token" value="{{ csrf_token }}"/>
    <div class="modal-fields field-grid">
      <label>Product name<input name="name" required maxlength="150" value="{{ product_form.name }}"/></label>
      <label>Category<select id="category" name="category" required>
          <option value="" {% if product_form.category not in allowed_categories %}selected{% endif %}>Select category</option>
          {# Use the shared category allowlist and restore the selected category after a validation failure. #}{% for category in allowed_categories %}
            <option value="{{ category }}" {% if product_form.category == category %}selected{% endif %}>{{ category }}</option>
          {% endfor %}
        </select></label>
      <label class="full">Description<textarea name="description" rows="3">{{ product_form.description }}</textarea></label>
      <label>Base price<input
          type="number"
          name="price"
          min="0"
          max="99999999.99"
          step="0.01"
          required
          value="{{ product_form.price }}"
        /></label>
      <label>Availability<select name="availability">
          <option value="Available" {% if product_form.availability == 'Available' %}selected{% endif %}>Available</option>
          <option value="Unavailable" {% if product_form.availability == 'Unavailable' %}selected{% endif %}>Unavailable</option>
        </select></label>
      {# Creation needs all three images; editing allows individual image replacements without clearing other slots. #}{% for number in 1..3 %}
        <label>Image {{ number }}{{ modal == 'edit-product' ? ' (optional replacement)' : '' }}<input
            type="file"
            name="image{{ number }}"
            accept="image/jpeg,image/png,image/webp"
            {% if modal == 'add-product' %}required{% endif %}
          /></label>
      {% endfor %}
    </div>
    <small>JPG, PNG or WebP; up to 5 MiB each. Select images again after a validation error.</small>
    {# Show blocked-choice settings using the current category and restored product choices. #}{% include 'components/flavour-availability.twig' with {category: product_form.category, unavailable_flavours: product_form.unavailable_flavours|default([])} %}
    {% include 'components/side-snack-availability.twig' with {category: product_form.category, unavailable_side_snacks: product_form.unavailable_side_snacks|default([])} %}
    <div id="variantsSection">
      <h3>Product variants</h3>
      <div class="admin-table">
        <div class="admin-tr variant-row head">
          <span>Variant label</span><span>Additional price</span><span>Stock</span><span></span>
        </div>
        <div id="variantList">
          {# Keep each existing variant ID aligned with its label, additional price, and stock inputs. #}{% for variant in product_form.variants %}
            <div class="admin-tr variant-row">
              <input type="hidden" name="variant_id[]" value="{{ variant.id }}"/>
              <input
                name="variant_oz[]"
                value="{{ variant.size_oz }}"
                maxlength="50"
                placeholder="Variant label"
                aria-label="Variant label"
                required
              />
              <input
                type="number"
                name="variant_price[]"
                value="{{ variant.price }}"
                min="0"
                max="99999999.99"
                step="0.01"
                aria-label="Variant additional price"
                required
              />
              <input
                type="number"
                name="variant_stock[]"
                value="{{ variant.stock }}"
                min="0"
                max="4294967295"
                aria-label="{{ variant.id ? 'Current stock (read only)' : 'Initial stock' }}"
                {# Existing inventory is read-only here; only new variants receive initial stock from this form. #}{% if variant.id %}readonly{% endif %}
                required
              />
              <button type="button" class="remove-variant">Remove</button>
            </div>
          {% endfor %}
        </div>
      </div>
      {# main.js appends new variant controls using the controller's expected array field names. #}<button type="button" id="addVariant" class="outline">＋ Add variant</button>
    </div>
    <h3>Optional add-ons</h3>
    <div id="addonList" class="addon-list">
      {# Keep saved add-on IDs with their editable names/prices so the model can validate product ownership. #}{% for addon in product_form.addons %}
        <div class="addon-row">
          <input type="hidden" name="addon_id[]" value="{{ addon.id }}"/>
          <input
            name="addon_name[]"
            value="{{ addon.name }}"
            placeholder="Add-on name"
            aria-label="Add-on name"
            maxlength="100"
            required
          />
          <input
            type="number"
            name="addon_price[]"
            value="{{ addon.price }}"
            min="0"
            max="99999999.99"
            step="0.01"
            aria-label="Add-on price"
            required
          />
          <button type="button" class="remove-addon">Remove</button>
        </div>
      {% endfor %}
    </div>
    {# Add another optional extra without submitting the product form. #}<button type="button" id="addAddon" class="outline">＋ Add add-on</button>
    <div class="admin-modal-actions">
      <a class="outline" href="/admin#admin-products">Cancel</a><button class="primary" type="submit">{{ modal == 'edit-product' ? 'Save product' : 'Add product' }}</button>
    </div>
  </form>
</section>
