{# AdminAuthController supplies the retained email, error, and separate administrator login CSRF token. #}<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Administrator sign in · Zen-Zen Snack Haus</title>
    <link href="{{ base_url }}public/style/style.css" rel="stylesheet"/>
  </head>
  <body>
    <main class="login-page">
      <div class="login-image login-image-photo-admin">
        <a class="logo logo-light" href="/"><span class="logo-mark">ZZ</span><span>Zen-Zen Snack Haus<small>SNACKS &amp; REFRESHMENTS</small></span></a>
        <div>
          <span class="kicker">ADMIN PORTAL</span>
          <h1>A fresh start<br/>for your shop.</h1>
          <p>Manage products, variant stock, orders, and customer activity.</p>
        </div>
        <small>© 2026 Zen-Zen Snack Haus</small>
      </div>
      {# Submit to administrator authentication, which verifies both the password and the persisted role. #}<form class="login-card" action="/admin/login" method="POST" id="form">
        <a class="back-link" href="/">← Back to shop</a>
        <div>
          <span class="kicker">ADMINISTRATOR ACCESS</span>
          <h1>Admin sign in</h1>
          <p>Use an account with administrator access.</p>
        </div>
        {# Display a sign-in failure message without exposing whether an administrator account exists. #}{% if error %}
          <p class="checkout-errors" role="alert">{{ error }}</p>
        {% endif %}
        {# Return the session token so the controller can reject cross-site or expired sign-in submissions. #}<input type="hidden" name="csrf_token" value="{{ csrf_token }}"/>
        {# Restore only the submitted email; the password field remains empty after an error. #}<label>Email address<input type="email" name="email" value="{{ email }}" autocomplete="username" maxlength="150" required/></label>
        <label>Password<input type="password" name="password" autocomplete="current-password" required id="password"/></label>
        <label class="auth-checkbox">
          <input type="checkbox" data-password-toggle="password" aria-controls="password" />
          Show password
        </label>
        <button class="primary" type="submit">Sign in to admin →</button>
        <p>Shopping instead? <a href="/login">Customer sign in</a></p>
      </form>
    </main>
    <script defer src="{{ base_url }}public/js/auth.js"></script>
  </body>
</html>
