{# This card is shared by the ranked home page and full menu; product contains a listing record with images. #}<article class="product-card">
  <a class="product-photo" href="/product/{{product.id}}">
    {# Show the first ordered product image only when a saved image exists. #}{% if product.images is not empty %}
      <img
        alt="{{ product.product_name }}"
        src="{{ base_url }}{{ product.images[0].image_path }}"
      />
    {% endif %}
    {# Mark unavailable products visibly while still allowing customers to open their details. #}{% if product.availability != 'Available' %}
      <span class="photo-badge"> Unavailable </span>
    {% endif %}
  </a>
  <div class="product-info">
    <div class="eyebrow-row">
      <span> {{ product.category }} </span>
    </div>
    <h3>
      <a href="/product/{{ product.id }}">{{ product.product_name }}</a>
    </h3>
    <p>{{ product.description }}</p>
    <div class="product-bottom">
      {# Format the base price for display; variants and extras are selected on the details page. #}<strong> ₱{{ product.base_price|number_format(2) }} </strong>
      {# Mark unavailable products visibly while still allowing customers to open their details. #}{% if product.availability != 'Available' %}
        <a class="text-link" href="/product/{{ product.id }}">View product</a>
      {% else %}
        <a
          class="add-circle"
          href="/product/{{ product.id }}"
          aria-label="Choose options for {{ product.product_name }}"
        > + </a>
      {% endif %}
    </div>
  </div>
</article>
