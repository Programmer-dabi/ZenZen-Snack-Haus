<header class="site-header">
  <div class="nav-wrap">
    <a class="logo" href="/">
      <span class="logo-mark"> ZZ </span>
      <span>
        Zen-Zen Snack Haus
        <small> SNACKS &amp; REFRESHMENTS </small>
      </span>
    </a>
    <nav aria-label="Main navigation">
      <a href="/"> Home </a>
      <a href="/products"> Menu </a>
      <a href="/#about"> Our Story </a>
      <a href="/#visit"> Visit Us </a>
      <a href="/account"> My Account </a>
      {# <a href="/logout"> logout (temp) </a> #}
    </nav>

    <div class="nav-actions">
      <a aria-label="Cart" href="/cart">
        Cart
        <span data-cart-count> ({{ cart_count|default(0) }}) </span>
      </a>
    </div>
    <button
      class="Hamburger"
      type="button"
      aria-label="Open menu"
      aria-controls="mobile-navigation"
      aria-expanded="false"
    >
      <span class="line1" aria-hidden="true"></span>
      <span class="line2" aria-hidden="true"></span>
      <span class="line3" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="navLinks" id="mobile-navigation" aria-label="Mobile navigation" hidden>
    <a href="/"> Home </a>
    <a href="/products"> Menu </a>
    <a href="/#about"> Our Story </a>
    <a href="/#visit"> Visit Us </a>
    <a href="/account">My Account</a>
    <a href="/cart">
      <span aria-hidden="true">Cart</span>
      <span data-cart-count aria-live="polite">{{ cart_count|default(0) }}</span>
    </a>
    {# <a href="/logout"> logout (temp) </a> #}
  </nav>
</header>
