{# Checked side-snack boxes mark blocked choices for Mix-n-Match products only. #}{# Hide and disable this group for other categories so irrelevant values are not submitted. #}<fieldset
  class="flavour-availability"
  data-side-snack-availability
  {% if category != 'Mix-n-Match' %}hidden
    disabled{% endif %}
>
  <legend>Side Snacks availability</legend>
  <p>All side snacks are available by default. Check a snack to mark it unavailable for this product.</p>
  <div class="flavour-availability-grid">
    {# Generate permitted side-snack names from Product and restore their blocked checkbox state. #}{% for snack in constant('App\\Models\\Product::SIDE_SNACKS') %}
      <label>
        <input
          type="checkbox"
          name="unavailable_side_snacks[]"
          value="{{ snack }}"
          {% if snack in unavailable_side_snacks %}checked{% endif %}
        />
        {{ snack }} — unavailable
      </label>
    {% endfor %}
  </div>
</fieldset>
