{# AuthenController supplies the remembered/submitted email, checkbox preference, and sign-in messages. #}<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Zen-Zen Snack Haus</title>
    <link href="{{base_url}}public/style/style.css" rel="stylesheet"/>
  </head>
  <body>
    {# Reuse the shop header; the controller-provided cart count populates its badges. #}{% include 'components/header.twig' %}

    <section class="login-page" id="login">

      <div class="login-image login-image-photo">
        <a class="logo logo-light" href="/">
          <span class="logo-mark"> ZZ</span>
          <span>
            Zen-Zen Snack Haus
            <small> SNACKS &amp; REFRESHMENTS </small>
          </span>
        </a>
        <div>
          <span class="kicker"> WELCOME BACK </span>
          <h1>
            Your next great cup
            <br />
            is just a few clicks away.
          </h1>
          <p>
            Order ahead, skip the wait, and make more time for the moments that
            matter.
          </p>
        </div>
        <small> © 2026 Zen-Zen Snack Haus </small>
      </div>
      {# Step: Submit the customer email and password to the login controller. #}
      {# Submit the existing email/password field names to the customer authentication action. #}<form method='POST' action = '/Authenticate' class="login-card">
        {# Display server validation feedback without treating message text as HTML. #}{% if err|default(null) %}
          <p role="alert">{{ err }}</p>
        {% endif %}
        <a class="back-link" href="/"> ← Back to shop </a>
        <div>
          <span class="kicker"> CUSTOMER ACCOUNT </span>
          <h1>Sign in</h1>
          <p>
            New to Zen-Zen Snack Haus?
            <a href='/register'> Create an account </a>
          </p>
        </div>
        <label>
          Email address
          <input
            placeholder="you@email.com"
            required=""
            type="email"
            name="email"
            autocomplete="username"
            value="{{ email|default('') }}"
          >
        </label>
        <label>
          Password
          <input
            placeholder="Enter your password"
            required=""
            type="password"
            name
            =
            "password"
            id="password"
            autocomplete="current-password"
          />
        </label>
        <label class="auth-checkbox">
          {# auth.js uses the target input ID to change password visibility without changing the submitted value. #}<input type="checkbox" data-password-toggle="password" aria-controls="password" />
          Show password
        </label>
        <div class="remember">
          <label class="auth-checkbox">
            <input
              type="checkbox"
              name="remember_me"
              value="1"
              {# Restore the email preference; this checkbox remembers an email, not an authenticated session. #}{% if remember_me|default(false) %}checked{% endif %}
              aria-describedby="remember-help"
            />
            Remember me
          </label>
        </div>
        <p class="auth-help" id="remember-help">
        </p>
        <input type="submit" value="Sign in →" class="primary" style="text-align: center">
      </form>
    </section>

    {# Reuse the common footer after this page's content. #}{% include 'components/footer.twig' %}

    <script defer src="{{base_url}}public/js/auth.js"></script>
    {# Load shared page interactions; each initializer checks that its own page controls exist. #}<script type="module" src="{{base_url}}public/js/main.js"></script>
  </body>
</html>
