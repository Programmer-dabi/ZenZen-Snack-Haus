{# The menu receives product-ID-keyed results and the current validated search/category from HomeController. #}<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Our menu · Zen-Zen Snack Haus</title>
    <link href="{{ base_url }}public/style/style.css" rel="stylesheet" />
  </head>
  <body>
    {# Reuse the shop header; the controller-provided cart count populates its badges. #}{% include 'components/header.twig' %}
    <main class="page-shell catalog-page">
      <div class="page-title">
        <span class="kicker">Find your favorite</span>
        <h1>Our menu</h1>
        <p>Snacks and refreshments for every craving.</p>
      </div>
      {# Submit filters as GET parameters so the current menu search is reflected in the URL. #}<form class="menu-tools catalog-tools" action="/products" method="get" role="search">
        <label class="catalog-field catalog-search" for="product-search">
          <span>Search products</span>
          <input
            id="product-search"
            type="search"
            name="q"
            value="{{ search }}"
            maxlength="200"
            placeholder="Search by name or description…"
          />
        </label>
        <label class="catalog-field" for="product-category">
          <span>Category</span>
          <select id="product-category" name="category" data-catalog-category>
            <option value="">All categories</option>
            {# Build the category list from the server allowlist and retain the selected filter. #}{% for category in categories %}
              <option value="{{ category }}"{% if selected_category == category %} selected{% endif %}>{{ category }}</option>
            {% endfor %}
          </select>
        </label>
        <button class="primary" type="submit">Search</button>
      </form>
      <div class="results-row">
        <span>{{ products|length }} {{ products|length == 1 ? 'product' : 'products' }}{% if selected_category %} in {{ selected_category }}{% endif %}{% if search %} matching “{{ search }}”{% endif %}</span>
        {# Offer a reset when a search or category is active. #}{% if search or selected_category %}<a class="text-link" href="/products">Clear filters</a>
        {% endif %}
      </div>
      <div class="product-grid catalog-grid">
        {# Render every matching product; the loop else provides the empty-results message. #}{% for product in products %}
          {% include 'components/product-card.twig' %}
        {% else %}
          <div class="catalog-empty">
            <h2>No products found</h2>
            <p>
              {# Offer a reset when a search or category is active. #}{% if search or selected_category %}Try another search or category.{% else %}Our menu is being prepared. Please check back soon.{% endif %}
            </p>
            {# Offer a reset when a search or category is active. #}{% if search or selected_category %}<a class="outline" href="/products">View all products</a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </main>
    {# Reuse the common footer after this page's content. #}{% include 'components/footer.twig' %}
    {# Load shared page interactions; each initializer checks that its own page controls exist. #}<script type="module" src="{{ base_url }}public/js/main.js"></script>
  </body>
</html>
