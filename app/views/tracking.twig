{# OrderController supplies private order data and workflow progress; main.js polls the status URL on this section. #}<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Zen-Zen Snack Haus</title>
    <link href="{{ base_url }}public/style/style.css" rel="stylesheet" />
  </head>
  <body>
    {# Reuse the shop header; the controller-provided cart count populates its badges. #}{% include 'components/header.twig' %}
    {# The data attribute gives JavaScript the owner-checked endpoint for refreshing this order. #}<section class="page-shell" id="tracking" data-tracking-status-url="/tracking/{{ order.id }}/status">
      <a class="back-link" href="/account#orders"> ← Back to my orders </a>
      <div class="tracking-card">
        <span class="kicker">ORDER #{{ order.order_number }}</span>
        <h1 data-tracking-heading>{{ tracking_heading }}</h1>
        <span class="status {{ status_class }}" data-tracking-status role="status" aria-live="polite">{{ status }}</span>
        <p class="safe-note" data-tracking-update-note role="status" aria-live="polite">
        </p>
        {# Show pickup-specific information only when the order has a saved pickup time. #}{% if order.pickup_time %}
          <p>
            Pickup schedule:
            <b>{{ order.pickup_time|date('M j, Y · g:i A', 'Asia/Manila') }}</b>
          </p>
        {% endif %}
        <div
          class="progress-list"
          data-tracking-progress
          aria-label="Order progress"
          {% if progress_step < 1 %}hidden{% endif %}
        >
          {# Render payment-specific stages; their data hooks let polling update progress and accessibility state. #}{% for step in tracking_steps %}
            <div
              class="progress {{ progress_step >= loop.index ? 'active' : '' }}"
              data-tracking-step="{{ loop.index }}"
              {% if progress_step == loop.index %}aria-current="step"{% endif %}
            >
              <span data-tracking-marker>{{ progress_step >= loop.index ? '✓' : loop.index }}</span>
              <div>
                <b data-tracking-step-label>{{ step }}</b>
                <small
                  data-tracking-step-note
                  {% if loop.index != progress_step and loop.index != progress_step + 1 %}hidden{% endif %}
                >{{ progress_step == loop.index ? 'Current status' : (progress_step + 1 == loop.index ? 'Up next' : '') }}</small>
              </div>
            </div>
          {% endfor %}
        </div>
        {# Show pickup-specific information only when the order has a saved pickup time. #}{% if order.pickup_time %}
          <div class="pickup-box">
            ▣
            <div>
              <small> PICKUP LOCATION </small>
              <b> Zen-Zen Snack Haus Arellano Dagupan </b>
            </div>
          </div>
        {% endif %}
        <h2>Order details</h2>
        <p>
          <b>{{ order.customer_name }}</b><br />
          {{ order.email }} · {{ order.phone_number }}<br />
          Placed {{ order.created_at|date('M j, Y · g:i A', false) }}<br />
          Mode of payment: {{ order.payment_label }}
        </p>
        {# Show the GCash information button/dialog only for orders using that payment code. #}{% if order.payment_method == 'gcash' %}
          <button
            class="primary"
            type="button"
            data-gcash-pay
            aria-haspopup="dialog"
            aria-controls="gcash-payment-modal"
          >Pay now</button>
        {% endif %}
        {# Show the saved item snapshots so later menu changes do not rewrite this order history. #}{% include 'components/order-items.twig' with {items: order.items} %}
        {% include 'components/delivery-address.twig' %}
        {# Only display the notes section when the saved order contains notes. #}{% if order.notes %}
          <p>
            <b>Order notes:</b> {{ order.notes }}
          </p>
        {% endif %}
        <hr />
        <div class="success-total">
          <span>Subtotal</span>
          <b>₱{{ order.subtotal|number_format(2) }}</b>
        </div>
        {# Show pickup-specific information only when the order has a saved pickup time. #}{% if order.pickup_time %}
          <p>Pickup fee: Free</p>
        {% endif %}
        <div class="success-total">
          <span>Total amount</span>
          <b>₱{{ order.total|number_format(2) }}</b>
        </div>
      </div>
    </section>
    {# Show the GCash information button/dialog only for orders using that payment code. #}{% if order.payment_method == 'gcash' %}
      <dialog
        class="gcash-payment-modal"
        id="gcash-payment-modal"
        aria-labelledby="gcash-payment-title"
        aria-describedby="gcash-payment-note"
      >
        {# This native dialog form closes the payment information panel without submitting a payment to the server. #}<form method="dialog" class="gcash-payment-header">
          <h2 id="gcash-payment-title">Pay with GCash</h2>
          <button type="submit" aria-label="Close payment modal" autofocus>×</button>
        </form>
        <p>Order #{{ order.order_number }} · <b>₱{{ order.total|number_format(2) }}</b></p>
        {# Replace this image source with the store's GCash QR code when ready. #}
        <img
          class="gcash-payment-qr"
          src="{{ base_url }}public/images/gcash-qr-placeholder.svg"
          alt="GCash QR code placeholder — payment QR code coming soon"
          width="360"
          height="360"
        />
        <p id="gcash-payment-note">Our GCash QR code will appear here soon.</p>
      </dialog>
    {% endif %}
    {# Reuse the common footer after this page's content. #}{% include 'components/footer.twig' %}
    {# Load shared page interactions; each initializer checks that its own page controls exist. #}<script type="module" src="{{ base_url }}public/js/main.js"></script>
  </body>
</html>
